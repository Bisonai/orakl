LOG_LEVEL=error
CHAIN=kairos
HEALTH_CHECK_INTERVAL=10s
BALANCE_CHECK_INTERVAL=10s
BALANCE_ALARM_INTERVAL=30m

SUBMITTER_ALARM_AMOUNT=25
DELEGATOR_ALARM_AMOUNT=10000

JSON_RPC_URL=
ORAKL_API_URL=
ORAKL_NODE_ADMIN_URL=
ORAKL_DELEGATOR_URL=
SUBMISSION_PROXY_CONTRACT=

SLACK_WEBHOOK_URL=


# (optional) defaults to 10s
DAL_CHECK_INTERVAL=
# (optional) HTTP port for /api/v1 + /metrics, defaults to 3000
# POR_PORT=3000

# Secrets below are read via secrets.GetSecret (Vault if configured, else env)
# (optional) Vault; VAULT_ROLE/JWT_PATH/VAULT_SECRET_PATH/VAULT_KEY_NAME must all be
# set, otherwise secrets fall back to env; VAULT_ADDR = Vault server (client default 127.0.0.1:8200)
# VAULT_ADDR=
# VAULT_ROLE=
# JWT_PATH=
# VAULT_SECRET_PATH=
# VAULT_KEY_NAME=

# Slack webhook used by checker alerts (secret); SLACK_WEBHOOK_URL above is not read by sentinel
SLACK_WEBHOOK_ENDPOINT=

# DAL checker (+ price checker): DAL API key (secret, required)
DAL_API_KEY=
# (optional) override DAL endpoints; default in-cluster DAL on kairos,
# https://dal.<CHAIN>.orakl.network + ws://dal.<CHAIN>.orakl.network/ws otherwise
# DAL_CHECK_REST_URL=https://dal.kairos.orakl.network
# DAL_CHECK_WS_URL=wss://dal.kairos.orakl.network/ws

# Health checker: (optional) extra service DB URL to check (secret)
# SERVICE_DB_URL=

# DB cronjob checker: cron DB connection URL (secret, required)
CRON_DB_CONNECTION_URL=

# Inspect checker (required)
INSPECTOR_PK=
KAIA_PROVIDER_URL=
ACC_ID=
VRF_KEYHASH=
INSPECT_CONSUMER_ADDRESS=

# (optional) peers checker interval, defaults to 10s
# PEER_CHECK_INTERVAL=10s
# (optional) signer checker interval, defaults to 24h
# SIGNER_CHECK_INTERVAL=24h

# (optional) on-chain checker, defaults to false; uses JSON_RPC_URL,
# SUBMISSION_PROXY_CONTRACT, CHAIN
# RUN_ONCHAIN_CHECKER=true
# (optional) on-chain poll interval, defaults to 10s
# ONCHAIN_CHECK_INTERVAL=10s

# (optional) feed config source, used by DAL + on-chain checkers
# defaults to https://config.orakl.network
# CONFIG_BASE_URL=https://config.orakl.network
# defaults to https://raw.githubusercontent.com/Bisonai/orakl-config/master; empty disables
# CONFIG_FALLBACK_URL=https://raw.githubusercontent.com/Bisonai/orakl-config/master
# (optional) on-chain config reload interval, defaults to 5m; 0 disables
# CONFIG_RELOAD_INTERVAL=5m

# (optional) DAL vs Binance price checker, defaults to false; uses DAL_API_KEY
# (queries mainnet DAL regardless of CHAIN)
# RUN_PRICE_CHECKER=true
# Slack webhook for price alerts (secret)
# PRICE_CHECK_SLACK=
# comma-separated BASE-QUOTE pairs, required when RUN_PRICE_CHECKER=true (sentinel exits if empty)
# PRICE_CHECK_PAIRS=BTC-USDT,ETH-USDT
# relative diff threshold, defaults to 0.01 (1%)
# PRICE_DIFF_THRESHOLD=0.01
