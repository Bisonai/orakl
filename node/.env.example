APP_PORT=
# not used by nodebin (only `nodebin state import`)
DATABASE_URL=
# nodebin signer keyring + rounds (create with `nodebin state init` or `state import`)
NODE_SQLITE_PATH=
# (optional) nodebin HTTP fetcher proxies: [location=]protocol://host:port,...
# FETCHER_PROXIES=
REDIS_HOST=
REDIS_PORT=

KAIA_PROVIDER_URL=
SUBMISSION_PROXY_CONTRACT=
DELEGATOR_URL=
SIGNER_PK=
ENCRYPT_PASSWORD=

# (optional) set up feed data stream from rdb to pgsql interval, defaults to 5s
FEED_DATA_STREAM_INTERVAL=

# (optional) designate external ip to be used if required
HOST_IP=

# `kairos` (Kaia testnet) or `mainnet` (Kaia mainnet), defaults to kairos
CHAIN=

# (optional) orakl-config source, defaults to https://config.orakl.network
# CONFIG_BASE_URL=
# (optional) secondary orakl-config source tried when the primary fails,
# defaults to https://raw.githubusercontent.com/Bisonai/orakl-config/master; set empty to disable
# CONFIG_FALLBACK_URL=
# (optional) reporter/DAL: re-read the feed config this often (Go duration), defaults to 5m;
# 0 disables polling (SIGHUP still reloads). Empty bundles or a >50% pair drop are refused.
# CONFIG_RELOAD_INTERVAL=

# use vault to get signer pk, will use SIGNER_PK if not set
VAULT_ADDR=
JWT_PATH=
VAULT_ROLE=
VAULT_SECRET_PATH=
VAULT_KEY_NAME=

# provider urls referenced from fetcher, should be websocket json rpc url
KAIA_WEBSOCKET_URL=
ETH_WEBSOCKET_URL=

# (optional) interval for streaming feed_data from redis -> pgsql, defaults to 10s
FEED_DATA_STREAM_INTERVAL=
# (optional) required if wallets table is empty
KAIA_REPORTER_PK=
# (optional) required to run kaia_helper test
TEST_FEE_PAYER_PK=

# (optional) required to set private network
PRIVATE_NETWORK_SECRET=

# (optional) `true`: a Raft leader skips heartbeats a recent trigger/price fix makes
# redundant (at least one every 1s), defaults to off. Every peer must run v0.0.32+.
# P2P_SPARSE_HEARTBEAT=

# (optional) defaults to 8089 if not set
BOOT_API_PORT=

# (optional) required if utilizing boot api, defaults to http://localhost:8089
BOOT_API_URL=

# (required for boot api) SQLite peer file, created if missing
BOOT_SQLITE_PATH=

# (optional) required to be true if running from local mac
WITHOUT_PING_PRIVILEGED=

# DAL

# (optoinal) defaults to 8090
DAL_API_PORT=

# (required)
# KAIA_WEBSOCKET_URL=

# (required)
# SUBMISSION_PROXY_CONTRACT=

# (required)
ORAKL_NODE_ADMIN_URL=

# (required)
# DATABASE_URL=
# REDIS_HOST=
# REDIS_PORT=